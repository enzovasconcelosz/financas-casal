rules_version = '2';

// Regras do Firestore para o Finanças do Casal.
// Cole isto em: Firebase › Firestore Database › Regras › Publicar.
//
// Cada acesso (e-mail do casal) só lê e grava o PRÓPRIO documento.
// O conteúdo já chega criptografado: nem quem administra o projeto lê os lançamentos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cofres/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // qualquer outro caminho: negado
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
