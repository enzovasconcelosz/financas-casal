# ============================================================================
# Configuração do bot de WhatsApp
# Copie para .env e preencha. Nunca publique o .env em repositório público.
# ============================================================================

# Porta do servidor (a maioria das hospedagens define sozinha)
PORT=8080

# Token que o SITE usa para falar com este servidor.
# Invente uma sequência longa e aleatória; cole a mesma em Ajustes > Bot do WhatsApp.
APP_TOKEN=troque-por-uma-sequencia-longa-e-aleatoria

# Endereço de onde o site é servido, para liberar o CORS.
# Ex.: https://seu-usuario.github.io   (use * apenas em teste local)
SITE_ORIGIN=*

# Só estes números podem lançar gastos. Separe por vírgula, com DDI e DDD.
# Deixar vazio libera qualquer número — não faça isso em produção.
ALLOWED_NUMBERS=5543999998888,5543988887777

# Qual serviço de WhatsApp: meta | twilio | evolution
PROVIDER=meta

# Fuso para "hoje"/"ontem". Hospedagens rodam em UTC; sem isto, mensagem
# mandada depois das 21h sairia com a data do dia seguinte.
TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Meta — WhatsApp Cloud API (developers.facebook.com)
# ---------------------------------------------------------------------------
META_TOKEN=
META_PHONE_ID=
META_VERIFY_TOKEN=escolha-uma-palavra-e-repita-no-painel-da-meta

# ---------------------------------------------------------------------------
# Evolution API (alternativa self-hosted)
# ---------------------------------------------------------------------------
EVOLUTION_URL=
EVOLUTION_KEY=
EVOLUTION_INSTANCE=

# ---------------------------------------------------------------------------
# Twilio não precisa de chave aqui: a resposta volta no próprio webhook (TwiML).
# Configure o webhook do Sandbox/número apontando para  POST /webhook
# ---------------------------------------------------------------------------

# Onde guardar a fila (opcional)
QUEUE_FILE=./fila.json
